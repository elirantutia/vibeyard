{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "outDir": "dist/renderer",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true
  },
  "include": ["src/renderer/**/*.ts", "src/shared/**/*.ts", "src/renderer/locales/*.json"],
  "exclude": ["src/renderer/**/*.test.ts"]
}
